# --- Required -------------------------------------------------------------
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id

# --- Optional -------------------------------------------------------------
# Register commands instantly in ONE server while testing (omit for global registration)
GUILD_ID=

# Netscape cookies.txt for YouTube (only needed if YouTube blocks your host: "Sign in to confirm you're not a bot")
YTDLP_COOKIES=

# Minutes to stay in an empty/idle voice channel
IDLE_LEAVE_MINUTES=3

# Your Discord user ID(s), comma separated: enables /admin (cookies, selftest, logs) and error alerts by DM
BOT_OWNER_ID=

# RAM limit of your host in MB; /stats shows how close you are (default 512)
MEMORY_LIMIT_MB=512

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error (default info)
LOG_LEVEL=info
# Log file (default data/logs/bot.log); set to "off" to log to the console only
LOG_FILE=
# Rotate the file at this size in MB (default 2) and keep this many old files (default 3)
LOG_MAX_MB=2
LOG_KEEP=3

# --- Advanced ---------------------------------------------------------------
# yt-dlp prefers a JavaScript runtime for YouTube. auto = only as a retry when a lookup fails (default),
# always = every lookup (about 1 s slower), off = never.
YTDLP_JS_RUNTIME=auto

# Free hosts stop servers that use too much CPU. Loudness leveling re-encodes every song (about 20x the CPU of
# passthrough). Set to off to start new servers without it (/normalize enabled:true turns it on per server).
# LEVELING_DEFAULT=off
